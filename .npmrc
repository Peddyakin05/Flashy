# Don't auto-run `pnpm install` before every `pnpm <script>`. pnpm 11's
# pre-run check otherwise fails on blocked native build scripts (esbuild/sharp/
# unrs-resolver), which would block `pnpm dev`, `pnpm build`, etc. Those
# packages work fine via their prebuilt platform binaries; run `pnpm install`
# (or `pnpm rebuild`) manually if you need to (re)build them from source.
verify-deps-before-run=false
