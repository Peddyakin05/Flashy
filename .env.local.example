# ---------------------------------------------------------------------------
# Flashy — environment variables
# Copy this file to `.env.local` and fill in your Supabase project values.
# `.env.local` is gitignored. The app runs WITHOUT these (it falls back to
# bundled sample data); set them to use a real Supabase database.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser (inlined into the client bundle).
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY — full admin access, bypasses Row Level Security.
# NEVER expose this to the browser, NEVER prefix it with NEXT_PUBLIC_, and
# NEVER commit it. Used only by scripts/seed.ts and server-side tooling.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional — canonical site URL used for absolute metadata / Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
